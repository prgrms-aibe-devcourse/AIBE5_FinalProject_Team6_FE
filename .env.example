# FANDROPS FE — 환경변수 예시
# 복사 후 .env 로 이름 변경: cp .env.example .env

# Express 서버 포트
PORT=3000

# Spring Boot 백엔드 URL
BACKEND_URL=http://localhost:8080

# 토스페이먼츠 클라이언트 키 (https://developers.tosspayments.com 에서 발급)
VITE_TOSS_CLIENT_KEY=test_ck_your_client_key_here

# 소셜 로그인 OAuth Client ID
# 카카오 REST API 키 (https://developers.kakao.com 에서 발급)
VITE_KAKAO_CLIENT_ID=your_kakao_rest_api_key_here
# 구글 OAuth Client ID (https://console.cloud.google.com 에서 발급)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# OAuth Redirect URI (배포 환경에서 반드시 설정)
# 로컬 기본값: http://localhost:5173/oauth/callback
# Vercel/EC2 배포 시: https://<배포도메인>/oauth/callback
VITE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback